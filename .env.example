# Copy to .env and fill in locally. NEVER commit .env or paste these values in chat.

# Mode: backtest | paper | signal_only | live   (default: paper)
TB_MODE=paper
# LIVE also needs runtime checks + explicit confirmation. Keep false.
TB_LIVE_TRADING_ENABLED=false

# SQLite for local dev; Postgres URL is set by docker-compose.
TB_DATABASE_URL=sqlite:///./data/trading_bot.db
TB_LOG_LEVEL=INFO
TB_LOG_JSON=true

# Zerodha Kite Connect (Connect plan, from developers.kite.trade)
TB_KITE_API_KEY=
TB_KITE_API_SECRET=

# Optional Telegram alerts
TB_TELEGRAM_BOT_TOKEN=
TB_TELEGRAM_CHAT_ID=

# Dashboard session signing key (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
TB_DASHBOARD_SECRET_KEY=

# Docker Postgres password (used by docker-compose only)
POSTGRES_PASSWORD=change-me-locally
